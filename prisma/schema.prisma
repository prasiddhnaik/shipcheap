generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model SavedComparison {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  appType   String
  budget    String
  database  String
  alwaysOn  Boolean
  hasCard   Boolean
  region    String
  riskLevel String

  resultJson Json

  @@index([createdAt])
}

model ApiRateLimitBucket {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  route       String
  identifier  String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([route, identifier, windowStart])
  @@index([route, identifier])
  @@index([updatedAt])
}

model PlatformSourceCheck {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  platformSlug        String
  sourceLabel         String
  sourceUrl           String

  lastCheckedAt       DateTime
  lastChangedAt       DateTime?
  status              String
  httpStatus          Int?
  contentHash         String?
  title               String?
  excerpt             String?
  changedSinceLastRun Boolean  @default(false)
  error               String?
  consecutiveFailures Int      @default(0)

  @@unique([platformSlug, sourceUrl])
  @@index([platformSlug])
  @@index([lastCheckedAt])
  @@index([status])
}

model FreshnessCheckRun {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String
  checkedSources Int       @default(0)
  failedSources  Int       @default(0)
  blockedSources Int       @default(0)
  changedSources Int       @default(0)
  resultJson     Json?
  error          String?
}

model GitHubInstallation {
  id                   String          @id @default(cuid())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  userId               String
  githubInstallationId String          @unique
  accountLogin         String
  accountType          String
  projects             LinkedProject[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model LinkedProject {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  userId             String
  installationId     String?
  githubRepositoryId String
  owner              String
  name               String
  fullName           String
  htmlUrl            String
  isPrivate          Boolean            @default(false)
  defaultBranch      String
  description        String?
  primaryLanguage    String?
  detectedStack      Json
  analysisJson       Json
  recommendationJson Json
  lastSyncedAt       DateTime           @default(now())
  installation       GitHubInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepositoryId])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([installationId])
}
